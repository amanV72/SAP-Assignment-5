<mvc:View
    controllerName="com.employee.employeemasterui.controller.ListView"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout">

    <Page
        id="employeeListPage"
        showHeader="false"
        class="employeeListPage">

        <content>

            <VBox
                width="100%"
                class="employeePageContainer">

                <!-- ================================================= -->
                <!-- PAGE HEADER                                      -->
                <!-- ================================================= -->

                <HBox
                    width="100%"
                    justifyContent="SpaceBetween"
                    alignItems="Start"
                    class="employeePageHeader">

                    <VBox>

                        <Title
                            text="Employee Master"
                            level="H1"
                            class="employeePageTitle"/>

                        <Text
                            text="Manage employee master data"
                            class="employeePageSubtitle"/>

                    </VBox>


                    <!-- HEADER ACTIONS -->

                    <HBox
                        alignItems="Center"
                        class="employeeHeaderActions">

                        <Button
                            text="Upload Excel"
                            icon="sap-icon://upload"
                            type="Emphasized"
                            press=".onUploadExcel"
                            class="employeeUploadButton"/>

                        <Button
                            text="Upload History"
                            icon="sap-icon://history"
                            type="Ghost"
                            press=".onUploadHistory"
                            class="employeeHistoryButton"/>

                    </HBox>

                </HBox>


                <!-- ================================================= -->
                <!-- SEARCH / FILTER BAR                               -->
                <!-- ================================================= -->

                <HBox
                    width="100%"
                    alignItems="Center"
                    justifyContent="SpaceBetween"
                    class="employeeFilterBar">

                    <!-- Left: filters + count -->
                    <HBox alignItems="Center" class="employeeFilterLeft">

                        <SearchField
                            id="employeeSearchField"
                            width="340px"
                            placeholder="Search Employee ID, name or email..."
                            liveChange=".onSearch"
                            class="employeeSearchField"/>

                        <Select
                            id="departmentFilter"
                            width="175px"
                            selectedKey="ALL"
                            change=".onDepartmentFilter"
                            class="employeeDepartmentFilter"
                            items="{
                                path: 'depts>/items',
                                templateShareable: false
                            }">

                            <core:Item
                                key="{depts>key}"
                                text="{depts>text}"/>

                        </Select>

                        <Select
                            id="managerFilter"
                            width="175px"
                            selectedKey="ALL"
                            change=".onManagerFilter"
                            class="employeeManagerFilter"
                            items="{
                                path: 'mgrs>/items',
                                templateShareable: false
                            }">

                            <core:Item
                                key="{mgrs>key}"
                                text="{mgrs>text}"/>

                        </Select>

                        <Text
                            id="employeeCountText"
                            text=""
                            class="employeeCountText"/>

                    </HBox>

                    <!-- Right: refresh -->
                    <Button
                        icon="sap-icon://refresh"
                        type="Transparent"
                        press=".onRefresh"
                        tooltip="Refresh"
                        class="employeeFilterRefreshBtn"/>

                </HBox>


                <!-- ================================================= -->
                <!-- TABLE CARD                                       -->
                <!-- ================================================= -->

                <VBox
                    width="100%"
                    class="employeeTableCard">

                    <Table
                        id="employeeTable"
                        width="100%"
                        inset="false"
                        growing="true"
                        growingThreshold="15"
                        mode="None"
                        fixedLayout="true"
                        showSeparators="Inner"
                        items="{rows>/filtered}"
                        class="employeeTable">

                        <columns>

                            <!-- EMPLOYEE ID -->

                            <Column
                                width="12%"
                                hAlign="Begin">

                                <Text
                                    text="Employee ID"
                                    class="employeeColumnHeader"/>

                            </Column>


                            <!-- NAME -->

                            <Column
                                width="16%"
                                hAlign="Begin">

                                <Text
                                    text="Employee Name"
                                    class="employeeColumnHeader"/>

                            </Column>


                            <!-- EMAIL -->

                            <Column
                                width="20%"
                                hAlign="Begin">

                                <Text
                                    text="Email"
                                    class="employeeColumnHeader"/>

                            </Column>


                            <!-- DEPARTMENT -->

                            <Column
                                width="12%"
                                hAlign="Begin">

                                <Text
                                    text="Department"
                                    class="employeeColumnHeader"/>

                            </Column>


                            <!-- MANAGER -->

                            <Column
                                width="12%"
                                hAlign="Begin">

                                <Text
                                    text="Manager"
                                    class="employeeColumnHeader"/>

                            </Column>


                            <!-- JOINING DATE -->

                            <Column
                                width="11%"
                                hAlign="Begin">

                                <Text
                                    text="Joining Date"
                                    class="employeeColumnHeader"/>

                            </Column>


                            <!-- SALARY -->

                            <Column
                                width="10%"
                                hAlign="End">

                                <Text
                                    text="Salary"
                                    class="employeeColumnHeader"/>

                            </Column>


                            <!-- LOCATION -->

                            <Column
                                width="10%"
                                hAlign="Begin">

                                <Text
                                    text="Location"
                                    class="employeeColumnHeader"/>

                            </Column>

                        </columns>


                        <!-- ================================================= -->
                        <!-- ROWS                                             -->
                        <!-- ================================================= -->

                        <items>

                            <ColumnListItem
                                type="Navigation"
                                press=".onEmployeePress"
                                class="employeeTableRow">


                                <!-- EMPLOYEE ID -->

                                <VBox
                                    justifyContent="Center"
                                    class="employeeIdCell">

                                    <Text
                                        text="{rows>employeeId}"
                                        class="employeeIdText"/>

                                </VBox>


                                <!-- EMPLOYEE NAME -->

                                <Text
                                    text="{rows>employeeName}"
                                    class="employeeCellText"/>


                                <!-- EMAIL -->

                                <Text
                                    text="{rows>email}"
                                    wrapping="false"
                                    class="employeeEmailText"/>


                                <!-- DEPARTMENT -->

                                <Text
                                    text="{rows>department_departmentName}"
                                    class="employeeCellText"/>


                                <!-- MANAGER -->

                                <Text
                                    text="{rows>manager_managerName}"
                                    class="employeeCellText"/>


                                <!-- JOINING DATE -->

                                <Text
                                    text="{rows>joiningDate}"
                                    class="employeeDateText"/>


                                <!-- SALARY -->

                                <ObjectNumber
                                    number="{rows>salary}"
                                    unit="INR"
                                    class="employeeSalaryText"/>


                                <!-- LOCATION -->

                                <Text
                                    text="{rows>location}"
                                    class="employeeCellText"/>

                            </ColumnListItem>

                        </items>

                    </Table>

                </VBox>


            </VBox>

        </content>

    </Page>

</mvc:View>